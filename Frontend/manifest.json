{
  "manifest_version": 3,
  "name": "Nest — Financial Automation",
  "version": "1.0.0",
  "description": "Nest — Scan POS reports and invoices, extract transactions with AI, and sync to QuickBooks Online.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "windows"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3000/*",
    "https://*.onrender.com/*",
    "*://*.toasttab.com/*",
    "*://*.salido.com/*",
    "*://*.oraclerestaurants.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "Nest"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.toasttab.com/*"],
      "js": ["content/scanner.js"]
    },
    {
      "matches": ["*://*.salido.com/*"],
      "js": ["content/salido-scanner.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.oraclerestaurants.com/*"],
      "js": ["content/oracle-scanner.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src data: http://localhost:3000 https://*.onrender.com https://appcenter.intuit.com https://oauth.platform.intuit.com https://sandbox-quickbooks.api.intuit.com"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "public/icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
